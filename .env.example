# ====== App ======
NODE_ENV=development
API_PORT=3001
DASHBOARD_PORT=3000

# ====== PostgreSQL for storage ======
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=brainstack
POSTGRES_PASSWORD=brainstack
POSTGRES_DB=brainstack_booking
DATABASE_URL=postgresql://brainstack:brainstack@localhost:5432/brainstack_booking
# true when POSTGRES_HOST is a managed free-tier provider (Neon, Supabase,
# etc.) that requires TLS — leave unset for local/Docker Postgres.
POSTGRES_SSL=false

# ====== Redis / BullMQ for caching ======
REDIS_HOST=localhost
REDIS_PORT=6379
# Only needed for a managed free-tier Redis (Upstash, Redis Cloud, etc.) —
# leave both unset for local/Docker Redis.
REDIS_PASSWORD=
REDIS_TLS=false

# ====== Admin dashboard auth (MVP: single shared password, no user accounts) ======
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ====== Twilio for communication ======
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ====== Deepgram for speech recognition ======
DEEPGRAM_API_KEY=

# ====== ElevenLabs for text-to-speech ======
ELEVENLABS_API_KEY=

# ====== Anthropic Claude for AI (intended production LLM — see docs/implementation.md) ======
ANTHROPIC_API_KEY=

# ====== LLM API key(s) for chat (MVP substitute — see docs/implementation.md) ======
# No longer configured here — managed at runtime from the admin dashboard's
# Settings page (gear icon in the account menu, password-gated). Add one or
# more API key + model pairs there; the first is used by default and it
# rotates to the next automatically if one hits a rate limit.

# ====== Knowledge base / RAG (local embeddings — no API key or quota) ======
KNOWLEDGE_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
KNOWLEDGE_TOP_K=3

# ====== Google OAuth for per-provider Calendar sync (Multi-Provider Scheduling Phase C) ======
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# ====== AWS S3 for storage ======
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# ====== Sentry for error tracking ======
SENTRY_DSN=
